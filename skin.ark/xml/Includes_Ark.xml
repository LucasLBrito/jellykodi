	<include name="JKRow">
		<param name="visible">true</param>
		<param name="sortby"></param>
		<param name="sortorder">ascending</param>
		<param name="limit">40</param>
		<definition>
			<control type="label" id="$PARAM[list_id]1">
				<left>80</left>
				<width>1200</width>
				<height>56</height>
				<aligny>bottom</aligny>
				<font>font27</font>
				<textcolor>FFE5E5E5</textcolor>
				<label>$PARAM[header]</label>
				<visible>[$PARAM[visible] + [Integer.IsGreater(Container($PARAM[list_id]).NumItems,0) | Container($PARAM[list_id]).IsUpdating]] | Control.HasFocus($PARAM[list_id])</visible>
			</control>
			<control type="fixedlist" id="$PARAM[list_id]">
				<left>80</left>
				<right>0</right>
				<height>232</height>
				<orientation>horizontal</orientation>
				<focusposition>0</focusposition>
				<movement>4</movement>
				<scrolltime tween="cubic" easing="out">350</scrolltime>
				<preloaditems>2</preloaditems>
				<onleft>9000</onleft>
				<onback>301</onback>
				<onfocus>SetProperty(jk_hero,$PARAM[list_id],home)</onfocus>
				<visible>[$PARAM[visible] + [Integer.IsGreater(Container($PARAM[list_id]).NumItems,0) | Container($PARAM[list_id]).IsUpdating]] | Control.HasFocus($PARAM[list_id])</visible>
				<itemlayout width="360" height="232">
					<control type="group">
						<top>20</top>
						<include content="JKCard"/>
					</control>
				</itemlayout>
				<focusedlayout width="360" height="232">
					<control type="group">
						<top>20</top>
						<animation type="Focus" reversible="false">
							<effect type="zoom" start="100" end="106" center="170,95" time="180" tween="sine" easing="out"/>
						</animation>
						<animation type="Unfocus" reversible="false">
							<effect type="zoom" start="106" end="100" center="170,95" time="150"/>
						</animation>
						<include content="JKCard">
							<param name="focused" value="true"/>
						</include>
						<control type="image">
							<left>-4</left>
							<top>-4</top>
							<width>348</width>
							<height>199</height>
							<texture border="12">jk/card_fo.png</texture>
							<visible>Control.HasFocus($PARAM[list_id])</visible>
						</control>
					</control>
				</focusedlayout>
				<content sortby="$PARAM[sortby]" sortorder="$PARAM[sortorder]" target="videos" limit="$PARAM[limit]">$PARAM[content]</content>
			</control>
		</definition>
	</include>
	<expression name="jk_hero_valid">[String.IsEqual(Window(home).Property(jk_hero),5100) + Integer.IsGreater(Container(5100).NumItems,0)] | [String.IsEqual(Window(home).Property(jk_hero),5150) + Integer.IsGreater(Container(5150).NumItems,0)] | [String.IsEqual(Window(home).Property(jk_hero),5050) + Integer.IsGreater(Container(5050).NumItems,0)] | [String.IsEqual(Window(home).Property(jk_hero),5200) + Integer.IsGreater(Container(5200).NumItems,0)] | [String.IsEqual(Window(home).Property(jk_hero),5300) + Integer.IsGreater(Container(5300).NumItems,0)] | [String.IsEqual(Window(home).Property(jk_hero),5400) + Integer.IsGreater(Container(5400).NumItems,0)] | [String.IsEqual(Window(home).Property(jk_hero),5500) + Integer.IsGreater(Container(5500).NumItems,0)]</expression>

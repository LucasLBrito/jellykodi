	<include name="JKCard">
		<param name="focused">false</param>
		<definition>
			<control type="image">
				<width>340</width>
				<height>191</height>
				<texture border="8">jk/card_bg.png</texture>
			</control>
			<control type="image">
				<width>340</width>
				<height>191</height>
				<aspectratio>scale</aspectratio>
				<texture background="true">$VAR[JKCardArt]</texture>
				<visible>$EXP[jk_card_has_art]</visible>
			</control>
			<control type="image">
				<left>120</left>
				<top>30</top>
				<width>100</width>
				<height>100</height>
				<aspectratio>keep</aspectratio>
				<texture>$INFO[ListItem.Icon]</texture>
				<visible>!$EXP[jk_card_has_art]</visible>
			</control>
			<control type="image">
				<top>91</top>
				<width>340</width>
				<height>100</height>
				<texture>jk/card_fade.png</texture>
			</control>
			<control type="label">
				<left>14</left>
				<top>118</top>
				<width>312</width>
				<height>30</height>
				<font>font13</font>
				<textcolor>FFFFFFFF</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label>$INFO[ListItem.Label]</label>
				<scroll>$PARAM[focused]</scroll>
			</control>
			<control type="label">
				<left>14</left>
				<top>154</top>
				<width>312</width>
				<height>22</height>
				<font>font10</font>
				<textcolor>B3FFFFFF</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>186</top>
				<width>340</width>
				<height>5</height>
				<texture colordiffuse="60FFFFFF">colors/white.png</texture>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
			<control type="progress">
				<left>0</left>
				<top>186</top>
				<width>340</width>
				<height>5</height>
				<texturebg></texturebg>
				<midtexture colordiffuse="button_focus">colors/white.png</midtexture>
				<info>ListItem.PercentPlayed</info>
				<visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
			</control>
		</definition>
	</include>


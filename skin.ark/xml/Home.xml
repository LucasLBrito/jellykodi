<?xml version="1.0" encoding="UTF-8"?>
<!-- Ark: tela inicial estilo Netflix (destaque + fileiras). Original da Estuary em backup/Home_v1.2.xml -->
<window>
	<defaultcontrol>301</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<onload condition="String.IsEmpty(Window(home).Property(jk_hero))">SetProperty(jk_hero,5100,home)</onload>
	<controls>
		<include>DefaultBackground</include>
		<!-- imagem de fundo do item em destaque -->
		<control type="image" id="100">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<aspectratio aligny="top">scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true">$VAR[JKHeroArt]</texture>
			<visible>!Player.HasVideo</visible>
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<texture>jk/hero_left.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>380</top>
			<right>0</right>
			<bottom>0</bottom>
			<texture>jk/hero_bottom.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<height>200</height>
			<texture>jk/top_shade.png</texture>
		</control>

		<!-- barra superior -->
		<control type="label">
			<left>80</left>
			<top>28</top>
			<width>320</width>
			<height>70</height>
			<aligny>center</aligny>
			<font>font45_title</font>
			<textcolor>FFE50914</textcolor>
			<label>ARK</label>
		</control>
		<control type="grouplist" id="9000">
			<left>420</left>
			<top>28</top>
			<width>760</width>
			<height>70</height>
			<orientation>horizontal</orientation>
			<itemgap>6</itemgap>
			<onright>9100</onright>
			<onleft>9100</onleft>
			<ondown>301</ondown>
				<control type="button" id="9001">
					<width>auto</width>
					<height>70</height>
					<label>Início</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick>SetFocus(500)</onclick>
				</control>
				<control type="button" id="9002">
					<width>auto</width>
					<height>70</height>
					<label>Séries</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick condition="Library.HasContent(tvshows)">ActivateWindow(Videos,videodb://tvshows/titles/,return)</onclick>
					<onclick condition="Library.HasContent(tvshows)">AlarmClock(jkview,Container.SetViewMode(500),00:01,silent)</onclick>
					<onclick condition="!Library.HasContent(tvshows)">ActivateWindow(Videos,sources://video/,return)</onclick>
				</control>
				<control type="button" id="9003">
					<width>auto</width>
					<height>70</height>
					<label>Filmes</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick condition="Library.HasContent(movies)">ActivateWindow(Videos,videodb://movies/titles/,return)</onclick>
					<onclick condition="Library.HasContent(movies)">AlarmClock(jkview,Container.SetViewMode(500),00:01,silent)</onclick>
					<onclick condition="!Library.HasContent(movies)">ActivateWindow(Videos,sources://video/,return)</onclick>
				</control>
				<control type="button" id="9004">
					<width>auto</width>
					<height>70</height>
					<label>Pastas</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick>ActivateWindow(Videos,sources://video/,return)</onclick>
				</control>
				<control type="button" id="9005">
					<width>auto</width>
					<height>70</height>
					<label>Pesquisar</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick>ActivateWindow(1107)</onclick>
				</control>
		</control>
		<control type="grouplist" id="9100">
			<right>60</right>
			<top>28</top>
			<width>760</width>
			<height>70</height>
			<orientation>horizontal</orientation>
			<align>right</align>
			<itemgap>6</itemgap>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<ondown>301</ondown>
				<control type="button" id="9105">
					<width>auto</width>
					<height>70</height>
					<label>Atualizar</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick>RunPlugin(plugin://plugin.video.ark/?action=update)</onclick>
				</control>
				<control type="button" id="9101">
					<width>auto</width>
					<height>70</height>
					<label>Monitor</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick>RunPlugin(plugin://plugin.video.ark/?action=monitor)</onclick>
				</control>
				<control type="button" id="9102">
					<width>auto</width>
					<height>70</height>
					<label>Otimizar</label>
					<font>font27</font>
					<textoffsetx>18</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFB3B3B3</textcolor>
					<focusedcolor>FFFFFFFF</focusedcolor>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
					<onclick>RunPlugin(plugin://plugin.video.ark/?action=optimize)</onclick>
				</control>
				<control type="button" id="9103">
					<width>70</width>
					<height>70</height>
					<label></label>
					<onclick>ActivateWindow(settings)</onclick>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
				</control>
				<control type="button" id="9104">
					<width>70</width>
					<height>70</height>
					<label></label>
					<onclick>ActivateWindow(shutdownmenu)</onclick>
					<texturefocus colordiffuse="40FFFFFF" border="8">jk/btn_white.png</texturefocus>
					<texturenofocus />
				</control>
		</control>
		<control type="image">
			<right>154</right>
			<top>43</top>
			<width>40</width>
			<height>40</height>
			<texture colordiffuse="FFB3B3B3">icons/settings.png</texture>
		</control>
		<control type="image">
			<right>78</right>
			<top>43</top>
			<width>40</width>
			<height>40</height>
			<texture colordiffuse="FFB3B3B3">icons/power.png</texture>
		</control>

		<!-- destaque (hero) -->
		<control type="group">
			<left>80</left>
			<top>170</top>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<control type="label">
				<width>1100</width>
				<height>90</height>
				<font>font52_title</font>
				<textcolor>FFFFFFFF</textcolor>
				<shadowcolor>A0000000</shadowcolor>
				<label>$VAR[JKHeroTitle]</label>
			</control>
			<control type="label">
				<top>92</top>
				<width>1100</width>
				<height>40</height>
				<font>font14</font>
				<textcolor>FF46D369</textcolor>
				<label>$VAR[JKHeroSub]</label>
			</control>
			<control type="textbox">
				<top>140</top>
				<width>820</width>
				<height>117</height>
				<font>font13</font>
				<textcolor>FFE5E5E5</textcolor>
				<shadowcolor>A0000000</shadowcolor>
				<label>$VAR[JKHeroPlot]</label>
				<autoscroll delay="6000" time="2000" repeat="8000">true</autoscroll>
			</control>
			<control type="grouplist" id="300">
				<top>266</top>
				<width>900</width>
				<height>76</height>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>
				<onup>9000</onup>
				<ondown>500</ondown>
				<control type="button" id="301">
					<width>250</width>
					<height>76</height>
					<label>        Assistir</label>
					<font>font27</font>
					<align>center</align>
					<textoffsetx>16</textoffsetx>
					<aligny>center</aligny>
					<textcolor>FF000000</textcolor>
					<focusedcolor>FF000000</focusedcolor>
					<texturefocus border="8">jk/btn_white.png</texturefocus>
					<texturenofocus border="8" colordiffuse="D9FFFFFF">jk/btn_white.png</texturenofocus>
						<onclick condition="$EXP[jk_hero_valid] | $EXP[jk_any_row]">SetFocus($VAR[JKHeroRow])</onclick>
						<onclick condition="$EXP[jk_hero_valid] | $EXP[jk_any_row]">Action(Select)</onclick>
						<onclick condition="!$EXP[jk_hero_valid] + !$EXP[jk_any_row]">ActivateWindow(Videos,sources://video/,return)</onclick>
				</control>
				<control type="button" id="302">
					<width>380</width>
					<height>76</height>
					<label>        Mais informações</label>
					<font>font27</font>
					<align>center</align>
					<textoffsetx>16</textoffsetx>
					<aligny>center</aligny>
					<textcolor>FFFFFFFF</textcolor>
					<focusedcolor>FF000000</focusedcolor>
					<texturefocus border="8">jk/btn_white.png</texturefocus>
					<texturenofocus border="8">jk/btn_grey.png</texturenofocus>
						<onclick condition="$EXP[jk_hero_valid] | $EXP[jk_any_row]">SetFocus($VAR[JKHeroRow])</onclick>
						<onclick condition="$EXP[jk_hero_valid] | $EXP[jk_any_row]">Action(Info)</onclick>
				</control>
			</control>
			<control type="image">
				<left>30</left>
				<top>284</top>
				<width>40</width>
				<height>40</height>
				<texture colordiffuse="FF000000">icons/now-playing/play.png</texture>
			</control>
			<control type="image">
				<left>296</left>
				<top>284</top>
				<width>40</width>
				<height>40</height>
				<texture colordiffuse="$VAR[JKInfoIconColor]">icons/infodialogs/info.png</texture>
			</control>
		</control>

		<!-- fileiras -->
		<control type="grouplist" id="500">
			<left>0</left>
			<top>600</top>
			<right>0</right>
			<bottom>0</bottom>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<scrolltime tween="cubic" easing="out">350</scrolltime>
			<onup>301</onup>
			<usecontrolcoords>true</usecontrolcoords>
				<include content="JKRow">
					<param name="list_id" value="5100"/>
					<param name="header" value="Continuar assistindo"/>
					<param name="content" value="plugin://plugin.video.ark/?action=continue&amp;r=$INFO[Window(home).Property(jk_refresh)]"/>
				</include>
				<include content="JKRow">
					<param name="list_id" value="5150"/>
					<param name="header" value="Por tema"/>
					<param name="content" value="plugin://plugin.video.ark/?action=themes&amp;r=$INFO[Window(home).Property(jk_refresh)]"/>
				</include>
				<control type="label" id="50501">
					<left>80</left>
					<width>1200</width>
					<height>56</height>
					<aligny>bottom</aligny>
					<font>font27</font>
					<textcolor>FFE5E5E5</textcolor>
					<label>Adicionar e organizar</label>
				</control>
				<control type="fixedlist" id="5050">
					<left>80</left>
					<right>0</right>
					<height>232</height>
					<orientation>horizontal</orientation>
					<focusposition>0</focusposition>
					<movement>4</movement>
					<scrolltime tween="cubic" easing="out">350</scrolltime>
					<onleft>9000</onleft>
					<onback>301</onback>
					<preloaditems>2</preloaditems>
					<onfocus>SetProperty(jk_hero,5050,home)</onfocus>
					<itemlayout width="360" height="232">
						<control type="group">
							<top>20</top>
							<include content="JKToolCard"/>
						</control>
					</itemlayout>
					<focusedlayout width="360" height="232">
						<control type="group">
							<top>20</top>
							<animation type="Focus" reversible="false">
								<effect type="zoom" start="100" end="106" center="170,95" time="180" tween="sine" easing="out"/>
							</animation>
							<include content="JKToolCard"/>
							<control type="image">
								<left>-4</left>
								<top>-4</top>
								<width>348</width>
								<height>199</height>
								<texture border="12">jk/card_fo.png</texture>
								<visible>Control.HasFocus(5050)</visible>
							</control>
						</control>
					</focusedlayout>
					<content>
						<item>
							<label>Organizar Downloads</label>
							<label2>Põe séries e filmes baixados no lugar certo</label2>
							<icon>jk/ic_organize.png</icon>
							<thumb>jk/ic_organize.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=organize)</onclick>
						</item>
						<item>
							<label>Escolher pastas</label>
							<label2>Onde ficam suas séries, filmes e downloads</label2>
							<icon>jk/ic_folder.png</icon>
							<thumb>jk/ic_folder.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=folders)</onclick>
						</item>
						<item>
							<label>Abrir pasta Séries</label>
							<label2>Copie aqui as pastas das séries</label2>
							<icon>jk/ic_series.png</icon>
							<thumb>jk/ic_series.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=open_folder&amp;which=series)</onclick>
						</item>
						<item>
							<label>Abrir pasta Filmes</label>
							<label2>Copie aqui os filmes</label2>
							<icon>jk/ic_filmes.png</icon>
							<thumb>jk/ic_filmes.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=open_folder&amp;which=filmes)</onclick>
						</item>
						<item>
							<label>Atualizar capas</label>
							<label2>Busca imagens e sinopses na internet</label2>
							<icon>jk/ic_refresh.png</icon>
							<thumb>jk/ic_refresh.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=update)</onclick>
						</item>
						<item>
							<label>Nao identificados</label>
							<label2>O que eu nao consegui reconhecer</label2>
							<icon>jk/ic_folder.png</icon>
							<thumb>jk/ic_folder.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=open_unknown)</onclick>
						</item>
						<item>
							<label>Capas que faltam</label>
							<label2>Busca capa e sinopse do que ficou sem</label2>
							<icon>jk/ic_refresh.png</icon>
							<thumb>jk/ic_refresh.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=fetch_meta)</onclick>
						</item>
						<item>
							<label>Testar modelo local</label>
							<label2>Escolhe o modelo que roda neste PC</label2>
							<icon>jk/ic_organize.png</icon>
							<thumb>jk/ic_organize.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=test_model)</onclick>
						</item>
						<item>
							<label>Como adicionar</label>
							<label2>Passo a passo rápido</label2>
							<icon>jk/ic_help.png</icon>
							<thumb>jk/ic_help.png</thumb>
							<onclick>RunPlugin(plugin://plugin.video.ark/?action=help)</onclick>
						</item>
					</content>
				</control>
				<include content="JKRow">
					<param name="list_id" value="5200"/>
					<param name="header" value="Adicionados recentemente"/>
					<param name="content" value="plugin://plugin.video.ark/?action=recent&amp;r=$INFO[Window(home).Property(jk_refresh)]"/>
				</include>
				<include content="JKRow">
					<param name="list_id" value="5300"/>
					<param name="header" value="Filmes"/>
					<param name="content" value="videodb://movies/titles/"/>
					<param name="visible" value="Library.HasContent(movies)"/>
					<param name="sortby" value="dateadded"/>
					<param name="sortorder" value="descending"/>
				</include>
				<include content="JKRow">
					<param name="list_id" value="5400"/>
					<param name="header" value="Séries"/>
					<param name="content" value="videodb://tvshows/titles/"/>
					<param name="visible" value="Library.HasContent(tvshows)"/>
					<param name="sortby" value="lastplayed"/>
					<param name="sortorder" value="descending"/>
				</include>
				<include content="JKRow">
					<param name="list_id" value="5500"/>
					<param name="header" value="Suas pastas"/>
					<param name="content" value="sources://video/"/>
				</include>
		</control>
	</controls>
</window>

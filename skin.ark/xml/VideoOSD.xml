<?xml version="1.0" encoding="utf-8"?>
<!--
  Ark: menu do player simples, só com o que se usa pra assistir série/filme.
  Uma fileira de botoes no meio, com o nome do botão em foco escrito em cima.
  (O original da Estuary tinha 17 botões, metade de TV ao vivo/DVD/teletexto.)
-->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="button">
			<description>clicar no fundo fecha</description>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<bottom>300</bottom>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<include condition="Skin.HasSetting(touchmode)">TouchBackOSDButton</include>
		<control type="group">
			<include>Animation_BottomSlide</include>
			<bottom>0</bottom>
			<height>300</height>
			<visible>![Window.IsVisible(SliderDialog) | Window.IsVisible(1110) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)]</visible>
			<animation effect="fade" time="200">VisibleChange</animation>

			<!-- nome do botão em foco, grande e centralizado -->
			<control type="label">
				<left>0</left>
				<right>0</right>
				<top>20</top>
				<height>44</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font27</font>
				<textcolor>FFFFFFFF</textcolor>
				<shadowcolor>FF000000</shadowcolor>
				<label>$VAR[JKOSDHelp]</label>
			</control>

			<control type="group" id="200">
				<include>Animation_BottomSlide</include>
				<control type="grouplist" id="201">
					<left>0</left>
					<right>0</right>
					<top>76</top>
					<height>90</height>
					<itemgap>22</itemgap>
					<align>center</align>
					<scrolltime tween="sine">200</scrolltime>
					<orientation>horizontal</orientation>
					<onup>87</onup>
					<ondown>Close</ondown>
					<onleft>noop</onleft>
					<onright>noop</onright>

					<control type="radiobutton" id="600">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/previous.png"/>
						</include>
						<onclick>PlayerControl(Previous)</onclick>
						<visible>Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1)</visible>
					</control>
					<control type="radiobutton" id="601">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/rewind.png"/>
						</include>
						<onclick>Action(StepBack,fullscreenvideo)</onclick>
						<visible>Player.SeekEnabled</visible>
					</control>
					<control type="group" id="698">
						<width>76</width>
						<height>76</height>
						<visible>Player.PauseEnabled</visible>
						<control type="button" id="602">
							<left>0</left>
							<top>0</top>
							<width>74</width>
							<height>74</height>
							<label></label>
							<font></font>
							<texturefocus colordiffuse="button_focus">osd/fullscreen/buttons/button-fo.png</texturefocus>
							<texturenofocus />
							<onleft>601</onleft>
							<onright>606</onright>
							<onup>87</onup>
							<ondown>Close</ondown>
							<onclick>PlayerControl(Play)</onclick>
						</control>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>74</width>
							<height>74</height>
							<animation center="38,38" effect="zoom" end="100" reversible="false" start="95" time="480" tween="back" condition="Control.HasFocus(602)">Conditional</animation>
							<texture colordiffuse="white">$VAR[PlayerControlsPlayImageVar]</texture>
						</control>
					</control>
					<control type="radiobutton" id="606">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/forward.png"/>
						</include>
						<onclick>Action(StepForward,fullscreenvideo)</onclick>
						<visible>Player.SeekEnabled</visible>
					</control>
					<control type="radiobutton" id="607">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/next.png"/>
						</include>
						<onclick>PlayerControl(Next)</onclick>
						<visible>Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1)</visible>
					</control>
					<control type="radiobutton" id="70046">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/settings-subtitle.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
					</control>
					<control type="radiobutton" id="70049">
						<include content="OSDButton">
							<param name="texture" value="dialogs/volume/volume2.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(osdaudiosettings)</onclick>
					</control>
					<control type="radiobutton" id="70044">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/bookmarks.png"/>
						</include>
						<onclick>Dialog.Close(VideoOSD)</onclick>
						<onclick>ActivateWindow(videobookmarks)</onclick>
					</control>
					<control type="radiobutton" id="603">
						<include content="OSDButton">
							<param name="texture" value="osd/fullscreen/buttons/stop.png"/>
						</include>
						<onclick>PlayerControl(Stop)</onclick>
					</control>
				</control>
			</control>

			<!-- barra de progresso: seta pra cima foca aqui e esquerda/direita avança -->
			<control type="group" id="6000">
				<top>0</top>
				<animation type="WindowOpen" condition="!Window.IsVisible(fullscreeninfo)" reversible="False">
					<effect type="fade" start="0" end="100" time="300"/>
					<effect type="slide" start="0,200" end="0,0" time="300" tween="cubic" easing="out" />
				</animation>
				<animation type="WindowClose" condition="!Window.IsVisible(fullscreeninfo)" reversible="False">
					<effect type="fade" start="100" end="0" time="300"/>
					<effect type="slide" start="0,0" end="0,200" time="300" tween="cubic" easing="out" />
				</animation>
				<visible>Player.SeekEnabled</visible>
				<control type="button" id="87">
					<include>HiddenObject</include>
					<onup>200</onup>
					<ondown>200</ondown>
					<onleft>StepBack</onleft>
					<onright condition="!Player.Paused">StepForward</onright>
					<onright condition="Player.Paused">PlayerControl(FrameAdvance(1))</onright>
				</control>
			</control>
		</control>
	</controls>
</window>
